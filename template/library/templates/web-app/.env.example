# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# THE RULE THAT MATTERS:
# Vite only exposes variables prefixed with VITE_ to browser code — and anything exposed
# to browser code is PUBLIC. Anyone can open devtools and read it. A VITE_ variable is
# fine for a public API base URL or a publishable key. It is never OK for a real secret.
#
# If a key must stay private, it cannot live in a frontend build at all. It needs a server
# or a serverless function.

# Safe to expose (public by design):
# VITE_API_BASE_URL=https://api.example.com
# VITE_PUBLISHABLE_KEY=pk_live_...

# Used only by Node scripts in this project, never imported by src/:
# SECRET_API_KEY=
