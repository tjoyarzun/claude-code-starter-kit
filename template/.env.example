# Workspace-level environment variables.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Project-specific secrets belong in that project's own .env, not here.

# GitHub (only needed if `gh auth login` isn't set up)
# GITHUB_TOKEN=

# API keys you reuse across projects
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RESEND_API_KEY=

# Reminder: in a Vite app, only VITE_-prefixed vars reach browser code —
# and anything that reaches browser code is public. Never prefix a real secret with VITE_.
